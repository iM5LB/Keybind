{
  "schemaVersion": 1,
  "id": "keybind",
  "version": "${version}",
  "name": "Keybind",
  "description": "Bind keys to server actions. Works with the Keybind server plugin.",
  "authors": ["iM5LB"],
  "contact": {
    "homepage": "https://github.com/iM5LB/Keybind",
    "sources": "https://github.com/iM5LB/Keybind",
    "issues": "https://github.com/iM5LB/Keybind/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["com.keybind.mod.KeybindMod"],
    "client": ["com.keybind.mod.client.KeybindModClient"]
  },
  "mixins": ["keybind-mod.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
